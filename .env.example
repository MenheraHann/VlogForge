# Gemini API 密钥（本地开发必填）
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud 项目（Vertex AI 模式必填）
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud Storage 存储桶（留空则仅用本地存储，Cloud Run 部署时必填）
GCS_BUCKET_NAME=

# API 认证密钥（留空则不启用认证，生产环境建议设置）
VLOGFORGE_API_KEY=

# 服务端口
PORT=8000
